{
  "name": "memorylink",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:mac": "npm run build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && electron-builder --mac"
  },
  "build": {
    "appId": "com.samayhash.memorylink",
    "productName": "MemoryLink",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "electron/loading.html",
      ".next/standalone/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mozilla/readability": "^0.6.0",
    "@pinecone-database/pinecone": "^9.0.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/jsdom": "^30.0.0",
    "@types/uuid": "^10.0.0",
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.0",
    "groq-sdk": "^1.6.0",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "get-port": "^7.2.0",
    "prisma": "^8.0.0-rc.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
